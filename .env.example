# ── Site URL (required for correct sitemap, canonical, and OG URLs) ─────────
# Your production domain, no trailing slash. Falls back to a placeholder
# example.com if unset, which is fine for local dev but must be set before
# deploying — search engines and social previews need the real URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# Any managed Postgres works: Neon, Supabase, Vercel Postgres, Railway, Render…
# Free tiers exist on all of the above and are enough to get started.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# 1. https://github.com/settings/developers → New OAuth App
# 2. Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (magic link) sign-in ───────────────────────────────────────────────
# Any SMTP server works, including the SMTP endpoints of Resend, Postmark,
# SendGrid, or Mailgun. Format: smtp://user:pass@host:port
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Picker <noreply@yourdomain.com>"

# ── Rate limiting (optional but recommended for production) ─────────────────
# Without these, API routes fall back to an in-memory limiter that only
# works correctly on a single server instance — fine for local dev, not for
# a real multi-instance deployment. Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
